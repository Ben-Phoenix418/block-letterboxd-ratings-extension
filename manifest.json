{
  "manifest_version": 3,
  "name": "Block Letterboxd Ratings",
  "version": "0.1.0",
  "description": "Hides the rating histogram and the average rating on Letterboxd film pages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "block-letterboxd-ratings@ben-phoenix",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Block Letterboxd Ratings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://letterboxd.com/film/*",
        "*://www.letterboxd.com/film/*"
      ],
      "css": ["src/block.css"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
